<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CodeForge</AssemblyName>
    <RootNamespace>CodeForge</RootNamespace>
    <ApplicationIcon>CodeForge.ico</ApplicationIcon>
    <Product>Kryndev</Product>
    <!-- The name Windows shows (Task Manager, file properties). The program stays CodeForge.exe so updates keep working. -->
    <AssemblyTitle>Kryndev</AssemblyTitle>
    <Company>Ahmed Al-Bazzaz</Company>
    <Authors>Ahmed Al-Bazzaz</Authors>
    <Copyright>Copyright © 2026 Ahmed Al-Bazzaz</Copyright>
    <Description>A small Visual Studio-style IDE for Windows</Description>
    <!-- Releases are framework-dependent: small, and they run on any PC with the .NET 10 Desktop Runtime. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeForge.Core\CodeForge.Core.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- Windows Forms is here for the form designer; keep its names out of the WPF code. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="CodeForge.ico" />
    <Resource Include="Logo.png" />
  </ItemGroup>

</Project>
