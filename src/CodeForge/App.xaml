<Application x:Class="CodeForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Placeholders; Themes.Apply sets the real colors at startup. -->
        <SolidColorBrush x:Key="WindowBrush" Color="#EEEEF2"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="ChromeBrush" Color="#EEEEF2"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CCCEDB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#6D6D6D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="EditorBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="EditorTextBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="LineNumberBrush" Color="#2B91AF"/>
        <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E51400"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#BF8803"/>
    </Application.Resources>
</Application>
