<Window x:Class="CodeForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeForge" Width="1280" Height="820" MinWidth="760" MinHeight="460"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="CodeForge.ico" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="Margin" Value="10,8,10,6"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menus, in Visual Studio's order -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" Padding="2,0"/>

        <!-- Standard toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,3">
                <Button x:Name="NewProjectButton" Style="{StaticResource IconButton}" Content="&#xE8F4;" ToolTip="New Project (Ctrl+Shift+N)"/>
                <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Content="&#xE8DA;" ToolTip="Open Folder (Ctrl+Shift+O)"/>
                <Button x:Name="SaveAllButton" Style="{StaticResource IconButton}" Content="&#xE78C;" ToolTip="Save All (Ctrl+Shift+S)"/>
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Navigate Backward (Ctrl+-)"/>
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Navigate Forward (Ctrl+Shift+-)"/>
                <Separator Margin="6,4"/>
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)"/>
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)"/>
                <Separator Margin="6,4"/>
                <ComboBox x:Name="ConfigurationBox" Width="96" Margin="2,0" VerticalAlignment="Center" ToolTip="Solution Configurations"/>
                <Button x:Name="StartButton" Margin="6,0,2,0" Padding="10,4" ToolTip="Start (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StartLabel" Text="Start" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource IconButton}" Content="&#xE71A;" Foreground="#DC2626" ToolTip="Stop (Shift+F5)"/>
                <Button x:Name="BuildButton" Style="{StaticResource IconButton}" Content="&#xE90F;" ToolTip="Build (Ctrl+Shift+B)"/>
            </StackPanel>
        </Border>

        <!-- Status bar: blue when ready, orange while running, purple with no folder -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="24" Background="#007ACC">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="StatusBranch" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock x:Name="StatusLanguage" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock x:Name="StatusPosition" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ready"/>
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolboxColumn" Width="220" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ExplorerColumn" Width="280" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- Toolbox -->
            <Border x:Name="ToolboxPane" Grid.Column="0" Background="{DynamicResource PanelBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneTitle}" Text="TOOLBOX"/>
                    <TextBox x:Name="ToolboxSearch" DockPanel.Dock="Top" Margin="8,0,8,6" ToolTip="Search Toolbox"/>
                    <Grid>
                        <TreeView x:Name="ToolboxTree" Background="Transparent" BorderThickness="0"/>
                        <TextBlock x:Name="ToolboxEmpty" TextWrapping="Wrap" TextAlignment="Center" Margin="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="ToolboxSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ShowsPreview="False"/>

            <!-- Editor area and the bottom panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="PanelRow" Height="220" MinHeight="0"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{DynamicResource EditorBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- The debug toolbar, shown while debugging -->
                    <Border x:Name="DebugBar" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
                            BorderBrush="#C2410C" BorderThickness="0,0,0,2" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DebugContinueButton" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="#16A34A" ToolTip="Continue (F5)"/>
                            <Button x:Name="DebugPauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="Break All"/>
                            <Button x:Name="DebugStopButton" Style="{StaticResource IconButton}" Content="&#xE71A;" Foreground="#DC2626" ToolTip="Stop Debugging (Shift+F5)"/>
                            <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>
                            <Button x:Name="DebugStepOverButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Step Over (F10)"/>
                            <Button x:Name="DebugStepIntoButton" Style="{StaticResource IconButton}" Content="&#xE74B;" ToolTip="Step Into (F11)"/>
                            <Button x:Name="DebugStepOutButton" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Step Out (Shift+F11)"/>
                            <TextBlock x:Name="DebugStatus" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource SubtleTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <TabControl x:Name="DocumentTabs" Grid.Row="1" BorderThickness="0" Padding="0" Background="{DynamicResource EditorBrush}"/>
                    <ScrollViewer x:Name="StartPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource EditorBrush}"/>
                </Grid>
                <GridSplitter x:Name="PanelSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ShowsPreview="False"/>
                <Border x:Name="BottomPanel" Grid.Row="2" Background="{DynamicResource PanelBrush}">
                    <TabControl x:Name="PanelTabs" BorderThickness="0" Padding="0" Background="{DynamicResource PanelBrush}">
                        <TabItem x:Name="OutputTab" Header="Output">
                            <DockPanel>
                                <TextBox x:Name="OutputInput" DockPanel.Dock="Bottom" Margin="4" ToolTip="Input for the running program: press Enter to send"/>
                                <TextBox x:Name="OutputText" IsReadOnly="True" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                         Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource EditorTextBrush}"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="ErrorsTab" Header="Error List">
                            <ListView x:Name="ErrorList" BorderThickness="0" Background="{DynamicResource EditorBrush}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="34">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Code" Width="80" DisplayMemberBinding="{Binding Code}"/>
                                        <GridViewColumn Header="Description" Width="420" DisplayMemberBinding="{Binding Message}"/>
                                        <GridViewColumn Header="File" Width="140" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="Line" Width="50" DisplayMemberBinding="{Binding Line}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                        <TabItem x:Name="TaskListTab" Header="Task List">
                            <DockPanel>
                                <TextBlock x:Name="TaskListSummary" DockPanel.Dock="Top" Margin="10,4" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="Comments with TODO, FIXME, HACK, UNDONE, BUG or XXX in the project are listed here."/>
                                <ListView x:Name="TaskList" BorderThickness="0" Background="{DynamicResource EditorBrush}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="File" Width="170" DisplayMemberBinding="{Binding FileName}"/>
                                            <GridViewColumn Header="Line" Width="60" DisplayMemberBinding="{Binding Line}"/>
                                            <GridViewColumn Header="Task" Width="620" DisplayMemberBinding="{Binding Text}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="FindResultsTab" Header="Find Results">
                            <DockPanel>
                                <TextBlock x:Name="FindSummary" DockPanel.Dock="Top" Margin="10,4" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="Use Find in Files (Ctrl+Shift+F) to search the whole project."/>
                                <ListView x:Name="FindResults" BorderThickness="0" Background="{DynamicResource EditorBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="File" Width="170" DisplayMemberBinding="{Binding FileName}"/>
                                            <GridViewColumn Header="Line" Width="60" DisplayMemberBinding="{Binding Line}"/>
                                            <GridViewColumn Header="Code" Width="620" DisplayMemberBinding="{Binding Text}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="DebugTab" Header="Debug">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="4">
                                    <Button x:Name="EvaluateButton" DockPanel.Dock="Right" Content="Evaluate" Padding="10,2" Margin="6,0,0,0"/>
                                    <TextBox x:Name="EvaluateInput" FontFamily="Cascadia Mono, Consolas"
                                             ToolTip="An expression to evaluate where the program is paused, for example: total * 2 (Enter)"/>
                                </DockPanel>
                                <TextBlock x:Name="EvaluateResult" DockPanel.Dock="Bottom" Margin="8,0" FontFamily="Cascadia Mono, Consolas"
                                           Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="280" MinWidth="100"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0">
                                        <TextBlock DockPanel.Dock="Top" Text="Locals" Margin="8,4" FontWeight="SemiBold"/>
                                        <TreeView x:Name="LocalsTree" BorderThickness="0" Background="{DynamicResource EditorBrush}"
                                                  FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                    </DockPanel>
                                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
                                    <DockPanel Grid.Column="2">
                                        <TextBlock DockPanel.Dock="Top" Text="Call Stack" Margin="8,4" FontWeight="SemiBold"/>
                                        <ListBox x:Name="CallStackList" BorderThickness="0" Background="{DynamicResource EditorBrush}" FontSize="12"/>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="TerminalTab" Header="Terminal">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="4">
                                    <TextBlock x:Name="TerminalPrompt" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,6,0" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource AccentBrush}" Text="PS&gt;"/>
                                    <TextBox x:Name="TerminalInput" FontFamily="Cascadia Mono, Consolas" ToolTip="Type a PowerShell command and press Enter (Up for history)"/>
                                </DockPanel>
                                <TextBox x:Name="TerminalText" IsReadOnly="True" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                         Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource EditorTextBrush}"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ShowsPreview="False"/>

            <!-- Solution Explorer -->
            <Border x:Name="ExplorerPane" Grid.Column="4" Background="{DynamicResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="100"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="PropertiesRow" Height="320" MinHeight="0"/>
                    </Grid.RowDefinitions>
                    <!-- Solution Explorer and Git Changes share the pane, as tabs, like in Visual Studio. -->
                    <TabControl x:Name="SideTabs" TabStripPlacement="Bottom" BorderThickness="0" Padding="0" Background="{DynamicResource PanelBrush}">
                    <TabItem x:Name="ExplorerTab" Header="Solution Explorer">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,2,4,0">
                                <Button x:Name="ExplorerNewFile" Style="{StaticResource IconButton}" FontSize="12" Content="&#xE8A5;" ToolTip="New File"/>
                                <Button x:Name="ExplorerNewFolder" Style="{StaticResource IconButton}" FontSize="12" Content="&#xE8F4;" ToolTip="New Folder"/>
                                <Button x:Name="ExplorerRefresh" Style="{StaticResource IconButton}" FontSize="12" Content="&#xE72C;" ToolTip="Refresh"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PaneTitle}" Text="SOLUTION EXPLORER"/>
                        </DockPanel>
                        <Grid>
                            <TreeView x:Name="ExplorerTree" Background="Transparent" BorderThickness="0"/>
                            <StackPanel x:Name="ExplorerEmpty" VerticalAlignment="Center" Margin="16">
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Text="No folder is open."/>
                                <Button x:Name="ExplorerOpenFolder" Content="Open Folder…" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                    </TabItem>
                    <TabItem x:Name="GitTab" Header="Git Changes"/>
                    </TabControl>
                    <GridSplitter x:Name="PropertiesSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ShowsPreview="False"/>
                    <Border x:Name="PropertiesHost" Grid.Row="2"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
